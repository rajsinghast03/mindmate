# AI Model Provider (Optional - works in local mock mode if omitted)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration (Phase 2 & beyond)
# Project URL: Dashboard → Connect, or Settings → Data API
# Client key:  Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy fallback (optional): NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
